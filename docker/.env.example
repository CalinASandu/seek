# Copy to docker/.env (git-ignored) and fill in.

# Tagged (tag:seek-hub), single-use auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Your tailnet's DNS name, e.g. tail1234.ts.net (the hub is then tls://seek-hub.tail1234.ts.net)
# Empty uses the address `init` saved; a value here overrides it.
SEEK_HUB_PUBLIC=tls://seek-hub.REPLACE-ME.ts.net

# Optional. Leave EMPTY to use what `init` saved; a value here overrides it. 1 also listens on 0.0.0.0:47321
# (uncomment the ports line in compose.yaml too).
SEEK_HUB_LAN=

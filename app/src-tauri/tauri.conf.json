{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seek",
  "version": "0.1.0",
  "identifier": "com.calinsandrei.seek",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seek",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Seek",
    "shortDescription": "Instant file-name search that remembers offline drives",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
